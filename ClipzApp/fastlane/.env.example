# Copy to `.env` (or `.env.default`) and fill in. fastlane auto-loads it.
# .env is gitignored — never commit real keys.

# ── App Store Connect API key (recommended — non-interactive) ─────────────
# Create at App Store Connect → Users and Access → Integrations → App Store Connect API.
# Download the .p8 once and store it somewhere safe (e.g. ~/.appstoreconnect/private/).
ASC_KEY_ID=XXXXXXXXXX
ASC_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ASC_KEY_PATH=$HOME/.appstoreconnect/private/AuthKey_XXXXXXXXXX.p8
# …or inline the key instead of a path:
# ASC_KEY_CONTENT="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# ASC_KEY_BASE64=false

# ── Signing team (Apple Developer Portal team id) ─────────────────────────
FASTLANE_TEAM_ID=XXXXXXXXXX

# ── Fallback: interactive Apple ID login (only if no API key) ─────────────
FASTLANE_APPLE_ID=you@example.com
# If your account belongs to multiple App Store Connect teams, set this:
# ITC_TEAM_ID=123456789
# An app-specific password (appleid.apple.com → Sign-In and Security) avoids 2FA prompts:
# FASTLANE_APPLE_APPLICATION_SPECIFIC_PASSWORD=abcd-efgh-ijkl-mnop
